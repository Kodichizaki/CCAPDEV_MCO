<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - HiramPH</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site-header" id="Home">
        <div class="container header">
            <div class="header-left">
                <img src="/images/logo.png" alt="Logo" class="logo-img">
            </div>
            <div class="header-center">
                <h1 class="brandname"><a href="/">HiramPH</a></h1>
            </div>
            <div class="header-right" id="header-right">
                <nav class="nav">
                    <a href="/">Home</a>
                    <a href="/marketplace">Marketplace</a>
                    <span id="prof-area">
                        <a href="/login" class="login-btn">Login</a>
                    </span>
                </nav>
            </div>
        </div>
    </header>

    <div class="container" id="admin-container" style="padding: 40px 0;">

        <div id="access-denied" style="display:none; text-align:center; padding: 50px;">
            <h2 style="color: red;">Access Denied</h2>
            <p>You must be an admin to view this page.</p>
            <a href="/" class="submit-btn" style="text-decoration:none; display:inline-block; margin-top:20px;">Return Home</a>
        </div>

        <div id="admin-content" style="display:none;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 class="section-title" style="margin: 0;">Admin Dashboard</h2>
            </div>

            <div style="background: #f9f9f9; padding: 25px; border-radius: 8px; margin-bottom: 40px; border: 1px solid #ddd; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                <h3 style="margin-top: 0; color: #333; border-bottom: 2px solid #c8a165; padding-bottom: 10px; display: inline-block;">Add New Item</h3>
                
                <div class="form-group" style="margin-top: 15px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px;">Item Name</label>
                    <input type="text" id="a-name" class="admin-input" placeholder="Enter item name" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px;">Categories (Select at least one)</label>
                    <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 5px;">
                        <label><input type="checkbox" class="cat-check" value="men"> Men</label>
                        <label><input type="checkbox" class="cat-check" value="women"> Women</label>
                        <label><input type="checkbox" class="cat-check" value="costumes"> Costumes</label>
                        <label><input type="checkbox" class="cat-check" id="footwear-cat-check" value="footwear"> Footwear</label>
                        <label><input type="checkbox" class="cat-check" value="accessories"> Accessories</label>
                    </div>
                </div>

                <div style="display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap;">
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px;">Display Price (e.g. ₱1,500)</label>
                        <input type="text" id="a-price" class="admin-input" placeholder="₱1,500" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                    <div class="form-group" style="flex: 1; min-width: 200px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px;">Math Value (e.g. 1500)</label>
                        <input type="number" id="a-priceval" class="admin-input" placeholder="1500" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px;">Sizes</label>
                    <div id="size-checkboxes" style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 5px;">
                        <label><input type="checkbox" class="size-check" value="XS"> XS</label>
                        <label><input type="checkbox" class="size-check" value="S"> S</label>
                        <label><input type="checkbox" class="size-check" value="M"> M</label>
                        <label><input type="checkbox" class="size-check" value="L"> L</label>
                        <label><input type="checkbox" class="size-check" value="XL"> XL</label>
                        <label><input type="checkbox" class="size-check" value="XXL"> XXL</label>
                    </div>
                    <div id="footwear-size-box" style="display: none; margin-top: 5px;">
                        <input type="number" id="footwear-size-input" class="admin-input" placeholder="Enter footwear size (e.g. 39)" style="padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                    </div>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px;">Item Image</label>
                    <input type="file" id="a-image-file" class="admin-input" accept="image/*" style="padding: 5px;">
                    <div id="image-preview-box" style="display:none; margin-top: 10px;">
                        <p style="color: #666; font-size: 0.9rem; margin-bottom: 5px;">Preview:</p>
                        <img id="image-preview" style="width: 150px; height: 150px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;">
                    </div>
                    <p id="image-upload-msg" style="font-size: 0.85rem; color: #28a745; margin-top: 6px; font-weight: bold;"></p>
                </div>

                <div class="form-group" style="margin-top: 20px;">
                    <label style="font-weight: bold; display: block; margin-bottom: 5px;">Description</label>
                    <textarea id="a-description" class="admin-input" rows="3" placeholder="Enter description..." style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;"></textarea>
                </div>

                <button class="submit-btn" id="addItemBtn" style="margin-top: 20px; padding: 12px 25px; font-size: 1rem;">Add Item to Store</button>
                <p id="add-msg" style="margin-top: 10px; font-weight: bold;"></p>
            </div>

            <div style="margin-top: 50px; border-top: 2px solid #ccc; padding-top: 30px;">
                <h2 class="section-title">Manage Inventory</h2>
                <div id="inventory-list" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px; background: #fff; padding: 15px; border-radius: 8px; border: 1px solid #eee;">
                    <p>Loading inventory...</p>
                </div>
            </div>

            <div style="margin-top: 50px; border-top: 2px solid #ccc; padding-top: 30px;">
                <h2 class="section-title">Manage Customer Orders</h2>
                <div id="admin-orders-list" style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">
                    <p>Loading customer orders...</p>
                </div>
            </div>

        </div>
    </div>

    <script src="/script.js"></script>
</body>
</html>