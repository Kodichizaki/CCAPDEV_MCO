<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HiramPH</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="site-header" id="Home">
        <div class="container header">

            <div class="header-left">
                <img src="images/logo.png" alt="Logo is Here" class="logo-img">
            </div>

            <div class="header-center">
                <h1 class="brandname"><a href="/">HiramPH</a></h1>
            </div>

            <div class="header-right", id="header-right">
                <nav class="nav">
                    <a href="/"> Home </a>
                    <a href="/#About">About </a> 
                    <a href="/contact">Contact </a> 

                    <span id="prof-area">
                        <a href="/login" class="login-btn">Login</a>
                    </span> 
                </nav>
            </div>
        </div>
    </header>

        <div class="container subheader">
            <details class="category-dropdown">
                <summary>Categories <span class="arrow">▼</span></summary>
                <div class="dropdown-content">
                    <a href="/marketplace?category=men">Men</a>
                    <a href="/marketplace?category=women">Women</a>
                    <a href="/marketplace?category=formal">Formal</a>
                    <a href="/marketplace?category=casual">Casual</a>
                    <a href="/marketplace?category=costumes">Costumes</a>
                    <a href="/marketplace?category=footwear">Footwear</a>
                    <a href="/marketplace?category=accessories">Accessories</a>
                </div>
            </details>
        </div>

    <div class="hero">
        <img src="images/heroclothes.jpg" alt="Hero Pic">
        <div class="hero-text">
            <h3>Show Off Your Style</h3>
        </div>
    </div>

    <div class="container features">
        <h2 class="section-title">Featured Clothes</h2>
        
        <div class="scroll-container">
            
            <div class="product-card">
                <a href="/product/1" style="text-decoration: none; color: inherit;">
                <div class="image-box">
                    <img src="images/men/batman2.jpg" alt="Batman Shirt">
                </div>
                <div class="card-details">
                    <p class="product-name">Batman Shirt</p>
                    <div class="price-row">
                        <span>S</span>
                        <span class="price">₱2,000</span>
                    </div>
                </div>
            </a>
            </div>

            <div class="product-card">
                <a href="/product/5" style="text-decoration: none; color: inherit;">
                <div class="image-box">
                    <img src="images/casual/shrek2.jpg" alt="Shrek Shirt">
                </div>
                <div class="card-details">
                    <p class="product-name">Shrek Shirt</p>
                    <div class="price-row">
                        <span>M</span>
                        <span class="price">₱1,000</span>
                    </div>
                </div>
            </a>
            </div>

            <div class="product-card">
                <a href="/product/4" style="text-decoration: none; color: inherit;">
                <div class="image-box">
                    <img src="images/women/filipiniana2.jpg" alt="Filipiniana Dress">
                </div>
                <div class="card-details">
                    <p class="product-name">Filipiniana Dress</p>
                    <div class="price-row">
                        <span>S</span>
                        <span class="price">₱3,400</span>
                    </div>
                </div>
                </a>
            </div>

            <div class="product-card">
                <a href="/product/3" style="text-decoration: none; color: inherit;">
                <div class="image-box">
                    <img src="images/men/mensshirt2.jpg" alt="Mens Summer Shirt">
                </div>
                <div class="card-details">
                    <p class="product-name">Mens Summer Shirt</p>
                    <div class="price-row">
                        <span>S</span>
                        <span class="price">₱2,500</span>
                    </div>
                </div>
                </a>
            </div>
            
            <div class="product-card">
                <div class="image-box">
                    <img src="images/costumes/grimace.jpg" alt="Grimace Costume">
                </div>
                <div class="card-details">
                    <a href="/product/6" style="text-decoration: none; color: inherit;">
                    <p class="product-name">Grimace Costume</p>
                    <div class="price-row">
                        <span>S</span>
                        <span class="price">₱4,000</span>
                    </div>
                </div>
                </a>
            </div>

            <div class="product-card">
                <a href="/product/2" style="text-decoration: none; color: inherit;">
                <div class="image-box">
                    <img src="images/men/promsuit.jpg" alt="Prom Suit">
                </div>
                <div class="card-details">
                    <p class="product-name">Prom Suit</p>
                    <div class="price-row">
                        <span>S</span>
                        <span class="price">₱4,000</span>
                    </div>
                </div>
                </a>
            </div>

        </div>
        <a href="/marketplace" class="submit-btn" style="text-decoration: none; display: inline-block; margin-top: 20px;">Browse Marketplace</a>
    </div>

    <div class="container about-us" id="About">
        <h2>About HiramPH</h2>
        <p>HiramPH is the Philippines' premier centralized clothing rental platform. We are fighting the "wear once" culture by offering an all-inclusive catalog for men, women, and cosplay enthusiasts. From business casuals to full costumes, we provide a sustainable, cost-effective, and convenient alternative to fast fashion. Hiram. Wear. Return.</p>
    </div>

    <div class="advert">
        <div class="container ad-content">
            <div class="ad-text">
                <h2>JOIN HIRAMPH TODAY</h2>
                <p>Be Updated On Exclusive Deals, New Arrivals, and Many More</p>
            </div>
            <a href="/signup" class="ad-btn">SIGN UP -></a>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
