<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings - HiramPH</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header">
            <div class="header-left">
                <img src="/images/logo.png" alt="Logo" class="logo-img">
            </div>
            <div class="header-center">
                <h1 class="brandname"><a href="/">HiramPH</a></h1>
            </div>
            <div class="header-right" id="header-right">
                <nav class="nav">
                    <a href="/">Home</a>
                    <a href="/marketplace">Marketplace</a>
                    <span id="prof-area"></span>
                </nav>
            </div>
        </div>
    </header>

    <div class="container" style="padding: 50px 20px; max-width: 600px; margin: 0 auto;">
        <h2 style="border-bottom: 2px solid #c8a165; padding-bottom: 10px; margin-bottom: 20px;">Account Settings</h2>
        
        <div style="background: #f9f9f9; padding: 30px; border-radius: 8px; border: 1px solid #ddd;">
            <form id="settingsForm">
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">Display Name</label>
                    <input type="text" id="s-name" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
                
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">Email Address</label>
                    <input type="email" id="s-email" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">New Password <span style="font-weight: normal; color: #666; font-size: 0.9rem;">(Leave blank to keep current password)</span></label>
                    <input type="password" id="s-password" placeholder="Enter new password..." style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
                
                <button type="submit" class="submit-btn" style="width: 100%; padding: 12px; font-size: 1.1rem;">Save Changes</button>
            </form>
        </div>
    </div>

    <script src="/script.js"></script>
</body>
</html>