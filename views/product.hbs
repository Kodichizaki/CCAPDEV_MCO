<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{item.name}} - HiramPH</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>
    <header class="site-header" id="Home">
        <div class="container header">
            <div class="header-left">
                <img src="/images/logo.png" alt="Logo" class="logo-img">
            </div>
            <div class="header-center">
                <h1 class="brandname"><a href="/">HiramPH</a></h1>
            </div>
            <div class="header-right" id="header-right">
                <nav class="nav">
                    <a href="/">Home</a>
                    <a href="/marketplace">Marketplace</a>
                    <span id="prof-area">
                        <a href="/login" class="login-btn">Login</a>
                    </span>
                </nav>
            </div>
        </div>
    </header>

    <div class="container" style="padding: 40px 0; display: flex; gap: 40px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 300px;">
            <img src="{{item.image}}" alt="{{item.name}}" style="width: 100%; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        </div>

        <div style="flex: 1; min-width: 300px;">
            <h1 style="margin-top: 0; font-size: 2.5rem; color: #333;">{{item.name}}</h1>
            <p style="font-size: 1.2rem; color: #c8a165; font-weight: bold; margin-bottom: 20px;">{{item.price}} / day</p>
            <p style="font-size: 1.1rem; color: #555;"><strong>Category:</strong> <span style="text-transform: capitalize;">{{item.category}}</span></p>
            <p style="font-size: 1.1rem; color: #555;"><strong>Size:</strong> {{item.size}}</p>
            <p style="font-size: 1rem; color: #666; line-height: 1.6; margin-top: 20px;">{{item.description}}</p>

            <div id="rent-section" style="margin-top: 30px; background: #f9f9f9; padding: 20px; border-radius: 8px; border: 1px solid #ddd;">
                <h3 style="margin-top: 0; color: #333; border-bottom: 2px solid #c8a165; padding-bottom: 10px;">Rent This Item</h3>
                <div style="display: flex; gap: 15px; margin-bottom: 15px; margin-top: 15px;">
                    <div style="flex: 1;">
                        <label style="display: block; margin-bottom: 5px; font-weight: bold;">Pickup Date</label>
                        <input type="text" id="startDate" placeholder="Select Date" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; background: white; cursor: pointer;">
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; margin-bottom: 5px; font-weight: bold;">Return Date</label>
                        <input type="text" id="endDate" placeholder="Select Date" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; background: white; cursor: pointer;">
                    </div>
                </div>
                <button id="rentBtn" class="submit-btn" 
                    data-id="{{item.id}}" 
                    data-name="{{item.name}}" 
                    data-price="{{item.price}}" 
                    data-priceval="{{item.priceVal}}" 
                    data-image="{{item.image}}" 
                    data-size="{{item.size}}"
                    style="width: 100%; padding: 12px; font-size: 1.1rem; margin-top: 10px;">
                    Add to Cart
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/script.js"></script>
</body>
</html>